# Copy to .env and adjust. Values are validated at startup (src/config/env.ts).

# development | test | production
NODE_ENV=development
PORT=5001

# Required. Any standard PostgreSQL instance.
DATABASE_URL="postgresql://USER@localhost:5432/cse_research_hub?schema=public"

# Frontend origin allowed by CORS (credentials enabled for cookie auth).
CORS_ORIGIN="http://localhost:3000"

# Optional OpenAlex API key (free: openalex.org/settings/api). Keyless requests get a smaller daily budget.
OPENALEX_API_KEY=

# Required. Signs session and password-reset tokens; at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# Optional. Set behind a reverse proxy so per-IP rate limits see client addresses
# (Express "trust proxy": true, a hop count such as 1, or loopback/subnets). Leave empty locally.
TRUST_PROXY=

# ── Professor password-recovery email (generic SMTP; any provider) ─────────────────────────
# Leave all of these empty to disable password recovery (requests then answer 503).
# Switching provider only means changing these values and restarting the backend.
#
# Gmail (personal account) — requires 2-Step Verification and an App Password
# (Google Account → Security → App passwords; not available for most work/school accounts):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com    SMTP_PASSWORD=<16-character app password, no spaces>
#   MAIL_FROM="CSE Research Hub <you@gmail.com>"
# Institute SMTP — use the host, port, TLS mode and credentials given by your IT department
# (access depends on their authorization). SMTP_SECURE=true means TLS from the start (usually
# port 465); false means STARTTLS, which is then required (usually port 587). SMTP_USER and
# SMTP_PASSWORD may both be empty for a relay without authentication.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── Licensed providers (Phase 15; Project_plan.md §13.6–§13.9) ─────────────────────────────
# Institution/department-owned credentials only (decision #120); never commit real values.
# Empty → the provider reports NOT_CONFIGURED and the other sources continue. There is no
# switch to disable a provider. Live Web of Science / JCR ingestion stays blocked until the
# provider-data removal tool and Clarivate's written confirmations are in place.
# Elsevier Scopus API key (dev.elsevier.com) and, outside the institution's IP range, the
# institutional token issued by Elsevier through the institution.
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
# Clarivate Web of Science Starter API key (developer.clarivate.com).
WOS_STARTER_API_KEY=
# Clarivate Web of Science Journals API key (Journal Citation Reports; paid add-on).
WOS_JOURNALS_API_KEY=

# ── Synchronization schedule (monthly; node-cron) ─────────────────────────────────────────
# Defaults: 02:00 on the 1st of every month, Asia/Kolkata. The admin can also start a sync manually.
SYNC_CRON=
SYNC_TIMEZONE=
# Journal Citation Reports refresh, on its own schedule (default 03:00 on the 15th, SYNC_TIMEZONE).
# Runs only with WOS_JOURNALS_API_KEY; a discovery run that adds records also starts one.
JCR_SYNC_CRON=
