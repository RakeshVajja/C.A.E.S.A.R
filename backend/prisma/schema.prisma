// CSE_Research_Hub data model — 14 tables: the 9 core tables and the 5 Phase 15 tables
// (Project_plan.md §6, §22.5; decisions #107–#125). Any other table needs the owner's approval.
// Conventions (decision log #19): UUID primary keys, timestamptz columns,
// snake_case table/column names in PostgreSQL, camelCase in TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PROFESSOR

  @@map("user_role")
}

/// Sources a professor identity can belong to.
enum IdentitySource {
  OPENALEX
  DBLP
  ORCID
  SCOPUS
  WOS

  @@map("identity_source")
}

/// Sources a publication record can come from (MANUAL = professor-entered).
enum PublicationSource {
  OPENALEX
  DBLP
  ORCID
  SCOPUS
  WOS
  MANUAL

  @@map("publication_source")
}

enum TypeFamily {
  PREPRINT
  CONFERENCE
  JOURNAL
  BOOK_CHAPTER
  BOOK
  OTHER

  @@map("type_family")
}

enum PublicationStatus {
  ACTIVE
  SUPPRESSED

  @@map("publication_status")
}

/// How a source record was attached to its canonical publication.
enum MatchMethod {
  DOI
  TITLE_YEAR
  NEW_PUBLICATION
  ADMIN

  @@map("match_method")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_status")
}

enum RelationshipOrigin {
  DISCOVERED
  MANUAL
  ADMIN

  @@map("relationship_origin")
}

enum DuplicateCandidateStatus {
  OPEN
  MERGED
  DISMISSED

  @@map("duplicate_candidate_status")
}

enum SyncTrigger {
  MANUAL
  SCHEDULED

  @@map("sync_trigger")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED

  @@map("sync_run_status")
}

enum SyncTaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  /// The task's provider has no credentials configured (§13.9); nothing was fetched or written.
  NOT_CONFIGURED

  @@map("sync_task_status")
}

/// Publication discovery runs and JCR journal-metrics runs share the engine (decision #123).
enum SyncRunKind {
  PUBLICATION_DISCOVERY
  JOURNAL_METRICS

  @@map("sync_run_kind")
}

enum SyncTaskKind {
  IDENTITY_DISCOVERY
  JOURNAL_METRICS

  @@map("sync_task_kind")
}

/// How an external identity was verified (decision #118). PRE_PHASE15 = not recorded: identities
/// created before Phase 15 (seed, demo script or the #68 preview flow) — provenance is not invented.
enum IdentityVerificationMethod {
  API_PREVIEW
  MANUAL_PROFILE
  PRE_PHASE15

  @@map("identity_verification_method")
}

enum JournalIssnKind {
  PRINT
  ELECTRONIC
  PREVIOUS

  @@map("journal_issn_kind")
}

/// JCR metric a category rank belongs to.
enum JcrRankMetric {
  JIF
  JCI

  @@map("jcr_rank_metric")
}

// ─── 1. User ───────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               UserRole
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Professor password recovery (Project_plan.md §15.4, decision #54): at most one active code
  // per user. Only a keyed HMAC of the code is stored, never the code itself.
  passwordResetCodeHash   String?   @map("password_reset_code_hash")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  passwordResetAttempts   Int       @default(0) @map("password_reset_attempts")
  passwordResetLastSentAt DateTime? @map("password_reset_last_sent_at") @db.Timestamptz(3)
  passwordResetSendCount  Int       @default(0) @map("password_reset_send_count")

  // Emailed temporary password of a professor account that is not yet activated (decision #102):
  // when it stops being accepted. NULL once the professor has chosen their own password.
  temporaryPasswordExpiresAt DateTime? @map("temporary_password_expires_at") @db.Timestamptz(3)

  professor            Professor?
  createdSourceRecords PublicationSourceRecord[] @relation("SourceRecordCreatedBy")
  decidedRelationships ProfessorPublication[]    @relation("RelationshipDecidedBy")
  resolvedDuplicates   DuplicateCandidate[]      @relation("DuplicateResolvedBy")
  triggeredSyncRuns    SyncRun[]                 @relation("SyncRunTriggeredBy")
  verifiedIdentities   ExternalIdentity[]        @relation("IdentityVerifiedBy")

  @@map("users")
}

// ─── 2. Professor ──────────────────────────────────────────────────────────

model Professor {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @map("user_id") @db.Uuid
  name        String
  department  String?
  designation String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  identities   ExternalIdentity[]
  publications ProfessorPublication[]

  @@map("professors")
}

// ─── 3. ExternalIdentity ───────────────────────────────────────────────────

/// A professor may have zero, one or several identities per source,
/// but one identity can never belong to two professors.
model ExternalIdentity {
  id                      String                     @id @default(uuid()) @db.Uuid
  professorId             String                     @map("professor_id") @db.Uuid
  source                  IdentitySource
  externalId              String                     @map("external_id")
  isActive                Boolean                    @default(true) @map("is_active")
  verifiedAt              DateTime?                  @map("verified_at") @db.Timestamptz(3)
  /// API preview (#68) or, for Scopus/WoS without credentials, the provider's public profile (#118).
  verificationMethod      IdentityVerificationMethod @default(PRE_PHASE15) @map("verification_method")
  verificationEvidenceUrl String?                    @map("verification_evidence_url")
  verifiedByUserId        String?                    @map("verified_by_user_id") @db.Uuid
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Professors are deactivated, never hard-deleted, so deletion is restricted.
  professor               Professor              @relation(fields: [professorId], references: [id], onDelete: Restrict)
  verifiedBy              User?                  @relation("IdentityVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  discoveredRelationships ProfessorPublication[]
  syncTasks               SyncTask[]

  @@unique([source, externalId])
  @@index([professorId])
  @@index([verifiedByUserId])
  @@map("external_identities")
}

// ─── 4. Publication (canonical) ────────────────────────────────────────────

model Publication {
  id                 String            @id @default(uuid()) @db.Uuid
  title              String
  normalizedTitle    String            @map("normalized_title")
  year               Int?
  venue              String?
  typeFamily         TypeFamily        @map("type_family")
  authorNamesDisplay String?           @map("author_names_display")
  /// Normalized DOI; NULL allowed for many rows, unique when present.
  doi                String?           @unique
  status             PublicationStatus @default(ACTIVE)
  isCurated          Boolean           @default(false) @map("is_curated")
  /// Per administrator-edited canonical field: { basis: INDEPENDENT | <provider> | PRE_PHASE15, evidence }
  /// (decision #125). Current state only, no history.
  curation           Json              @default("{}")
  /// Set only when the publication's ISSNs identify exactly one journal (decision #116).
  journalId          String?           @map("journal_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  journal              Journal?                  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  sourceRecords        PublicationSourceRecord[]
  professors           ProfessorPublication[]
  duplicateCandidatesA DuplicateCandidate[]      @relation("DuplicateCandidateA")
  duplicateCandidatesB DuplicateCandidate[]      @relation("DuplicateCandidateB")

  @@index([normalizedTitle])
  @@index([year])
  @@index([journalId])
  @@map("publications")
}

// ─── 5. PublicationSourceRecord ────────────────────────────────────────────

/// One publication as reported by one source. Several records (even from the
/// same source) may point to one canonical publication.
model PublicationSourceRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  publicationId      String            @map("publication_id") @db.Uuid
  source             PublicationSource
  /// OpenAlex W-id, DBLP record key, "{orcid}:{put-code}", Scopus EID, WoS accession number, or UUID for MANUAL.
  externalId         String            @map("external_id")
  title              String
  normalizedTitle    String            @map("normalized_title")
  doi                String?
  year               Int?
  venue              String?
  typeFamily         TypeFamily        @map("type_family")
  /// Display-only author names as reported by this source (feeds canonical selection, §9).
  authorNamesDisplay String?           @map("author_names_display")
  /// Source payload minus abstracts, references and full-text content.
  rawMetadata        Json?             @map("raw_metadata")
  matchMethod        MatchMethod       @map("match_method")
  matchDetail        String?           @map("match_detail")
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  /// Normalized ISSNs ("NNNN-NNNX") reported by this record, for journal linking (Phase 15).
  issns              String[]          @default([])
  /// MANUAL only (decision #125): INDEPENDENT, the provider the entry was derived from, or PRE_PHASE15.
  entryBasis         String?           @map("entry_basis")
  /// MANUAL only: DOI, publisher or repository URL, or note supporting the entry.
  entryEvidence      String?           @map("entry_evidence")
  firstSeenAt        DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt         DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // A publication cannot be deleted while source records reference it.
  publication          Publication           @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  createdBy            User?                 @relation("SourceRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  citationObservations CitationObservation[]

  @@unique([source, externalId])
  @@index([publicationId])
  @@index([doi])
  @@index([normalizedTitle])
  @@index([issns], type: Gin)
  @@map("publication_source_records")
}

// ─── 6. ProfessorPublication ───────────────────────────────────────────────

model ProfessorPublication {
  id                      String             @id @default(uuid()) @db.Uuid
  professorId             String             @map("professor_id") @db.Uuid
  publicationId           String             @map("publication_id") @db.Uuid
  status                  VerificationStatus @default(PENDING)
  origin                  RelationshipOrigin
  /// Identity whose sync discovered this relationship; NULL for manual/admin links.
  discoveredViaIdentityId String?            @map("discovered_via_identity_id") @db.Uuid
  decidedAt               DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedByUserId         String?            @map("decided_by_user_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  professor             Professor         @relation(fields: [professorId], references: [id], onDelete: Restrict)
  publication           Publication       @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  discoveredViaIdentity ExternalIdentity? @relation(fields: [discoveredViaIdentityId], references: [id], onDelete: SetNull)
  decidedBy             User?             @relation("RelationshipDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([professorId, publicationId])
  @@index([professorId, status])
  @@index([publicationId])
  @@index([discoveredViaIdentityId])
  @@map("professor_publications")
}

// ─── 7. DuplicateCandidate ─────────────────────────────────────────────────

/// A possible duplicate that was deliberately not merged automatically.
/// References become NULL if a publication is later removed (e.g. merged away),
/// so resolved candidates keep their status and reason.
model DuplicateCandidate {
  id               String                   @id @default(uuid()) @db.Uuid
  publicationAId   String?                  @map("publication_a_id") @db.Uuid
  publicationBId   String?                  @map("publication_b_id") @db.Uuid
  reason           String
  status           DuplicateCandidateStatus @default(OPEN)
  resolvedByUserId String?                  @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?                @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  publicationA Publication? @relation("DuplicateCandidateA", fields: [publicationAId], references: [id], onDelete: SetNull)
  publicationB Publication? @relation("DuplicateCandidateB", fields: [publicationBId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("DuplicateResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // The pair is stored in a canonical order (a < b), enforced by a CHECK constraint in the migration.
  @@unique([publicationAId, publicationBId])
  @@index([publicationBId])
  @@index([status])
  @@map("duplicate_candidates")
}

// ─── 8. SyncRun ────────────────────────────────────────────────────────────

model SyncRun {
  id                String        @id @default(uuid()) @db.Uuid
  kind              SyncRunKind   @default(PUBLICATION_DISCOVERY)
  trigger           SyncTrigger
  triggeredByUserId String?       @map("triggered_by_user_id") @db.Uuid
  status            SyncRunStatus @default(RUNNING)
  tasksTotal        Int           @default(0) @map("tasks_total")
  tasksSucceeded    Int           @default(0) @map("tasks_succeeded")
  tasksFailed       Int           @default(0) @map("tasks_failed")
  recordsFetched    Int           @default(0) @map("records_fetched")
  recordsNew        Int           @default(0) @map("records_new")
  recordsUpdated    Int           @default(0) @map("records_updated")
  linksCreated      Int           @default(0) @map("links_created")
  candidatesCreated Int           @default(0) @map("candidates_created")
  /// PUBLICATION_DISCOVERY runs: configuration state and identity count of the five mandatory
  /// providers when the run started (runOutcome.ts). NULL for JCR runs and runs before Phase 15.
  providerCoverage  Json?         @map("provider_coverage")
  /// JOURNAL_METRICS runs: JCR's database-wide content date (`/last-updated`) and their own counters.
  jcrDataUpdate     DateTime?     @map("jcr_data_update") @db.Date
  journalsChecked   Int           @default(0) @map("journals_checked")
  snapshotsAdded    Int           @default(0) @map("snapshots_added")
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz(3)

  triggeredBy User?      @relation("SyncRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  tasks       SyncTask[]

  @@index([startedAt])
  @@index([kind, startedAt])
  @@map("sync_runs")
}

// ─── 9. SyncTask ───────────────────────────────────────────────────────────

/// One task per external identity per discovery run; one task per journal per JCR run.
/// Hand-written CHECK (migration): IDENTITY_DISCOVERY tasks have a source and no journal;
/// JOURNAL_METRICS tasks have neither a source nor an identity. identity_id and journal_id stay
/// nullable so history outlives deleted identities and removed journals. UNIQUE(sync_run_id,
/// journal_id) allows one task per journal per run (identity tasks have a NULL journal, and NULLs
/// are distinct, so they are unaffected). New JOURNAL_METRICS tasks always reference a journal.
model SyncTask {
  id                String          @id @default(uuid()) @db.Uuid
  syncRunId         String          @map("sync_run_id") @db.Uuid
  kind              SyncTaskKind    @default(IDENTITY_DISCOVERY)
  identityId        String?         @map("identity_id") @db.Uuid
  journalId         String?         @map("journal_id") @db.Uuid
  source            IdentitySource?
  status            SyncTaskStatus  @default(PENDING)
  recordsFetched    Int             @default(0) @map("records_fetched")
  recordsNew        Int             @default(0) @map("records_new")
  recordsUpdated    Int             @default(0) @map("records_updated")
  linksCreated      Int             @default(0) @map("links_created")
  candidatesCreated Int             @default(0) @map("candidates_created")
  snapshotsAdded    Int             @default(0) @map("snapshots_added")
  warnings          Int             @default(0)
  errorMessage      String?         @map("error_message")
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(3)

  syncRun              SyncRun                 @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  identity             ExternalIdentity?       @relation(fields: [identityId], references: [id], onDelete: SetNull)
  journal              Journal?                @relation(fields: [journalId], references: [id], onDelete: SetNull)
  citationObservations CitationObservation[]
  metricSnapshots      JournalMetricSnapshot[]

  @@unique([syncRunId, journalId])
  @@index([syncRunId])
  @@index([identityId])
  @@index([journalId])
  @@map("sync_tasks")
}

// ─── 10. CitationObservation (Phase 15) ────────────────────────────────────

/// One provider's citation count for one source record at one time (decisions #111, #112).
/// Append-only; never updated. Hand-written CHECKs: provider is SCOPUS or WOS, count ≥ 0.
model CitationObservation {
  id             String            @id @default(uuid()) @db.Uuid
  sourceRecordId String            @map("source_record_id") @db.Uuid
  provider       PublicationSource
  /// Provider database the count refers to (e.g. WoS "WOS"); NULL when the provider has one.
  database       String?
  count          Int
  observedAt     DateTime          @map("observed_at") @db.Timestamptz(3)
  syncTaskId     String?           @map("sync_task_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceRecord PublicationSourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  syncTask     SyncTask?               @relation(fields: [syncTaskId], references: [id], onDelete: SetNull)

  @@unique([sourceRecordId, syncTaskId])
  @@index([sourceRecordId, observedAt])
  @@index([provider, observedAt])
  @@index([syncTaskId])
  @@map("citation_observations")
}

// ─── 11. Journal (Phase 15) ────────────────────────────────────────────────

/// JCR journal identity (decision #116). Profile fields may be refreshed; metrics live in snapshots.
model Journal {
  id             String   @id @default(uuid()) @db.Uuid
  /// JCR journal id, e.g. "PLOS_ONE".
  jcrId          String   @unique @map("jcr_id")
  name           String
  jcrTitle       String?  @map("jcr_title")
  isoTitle       String?  @map("iso_title")
  publisherName  String?  @map("publisher_name")
  firstIssueYear Int?     @map("first_issue_year")
  frequency      Int?
  language       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  issns        JournalIssn[]
  snapshots    JournalMetricSnapshot[]
  publications Publication[]
  syncTasks    SyncTask[]

  @@map("journals")
}

// ─── 12. JournalIssn (Phase 15) ────────────────────────────────────────────

/// Print, electronic and previous ISSNs of a journal. An ISSN listed for two journals is
/// ambiguous and never used for linking (hence no global uniqueness on issn).
model JournalIssn {
  id            String          @id @default(uuid()) @db.Uuid
  journalId     String          @map("journal_id") @db.Uuid
  issn          String          @db.Char(9)
  kind          JournalIssnKind
  validFromYear Int?            @map("valid_from_year")
  validToYear   Int?            @map("valid_to_year")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, issn])
  @@index([issn])
  @@map("journal_issns")
}

// ─── 13. JournalMetricSnapshot (Phase 15) ──────────────────────────────────

/// One revision of one journal's JCR report for one JCR year (decision #122). Insert-only: a new
/// revision is added only when the normalized payload hash differs from the latest revision.
/// Published values are kept as returned; numeric parses are stored separately (#114).
model JournalMetricSnapshot {
  id                   String    @id @default(uuid()) @db.Uuid
  journalId            String    @map("journal_id") @db.Uuid
  jcrYear              Int       @map("jcr_year")
  revision             Int
  /// SHA-256 (hex) of the normalized report.
  payloadHash          String    @map("payload_hash") @db.Char(64)
  /// JCR's database-wide content date at retrieval (`/last-updated`), when available.
  jcrDataUpdate        DateTime? @map("jcr_data_update") @db.Date
  retrievedAt          DateTime  @map("retrieved_at") @db.Timestamptz(3)
  syncTaskId           String?   @map("sync_task_id") @db.Uuid
  // Returned directly by the API.
  totalCites           Int?      @map("total_cites")
  jifText              String?   @map("jif_text")
  jifWithoutSelfText   String?   @map("jif_without_self_text")
  jif5Years            Float?    @map("jif_5_years")
  immediacyIndex       Float?    @map("immediacy_index")
  jci                  Float?
  averageJifPercentile Float?    @map("average_jif_percentile")
  suppressed           Boolean?
  onHold               Boolean?  @map("on_hold")
  delisted             Boolean?
  // Derived: numeric parses of the published text values (NULL when not numeric, e.g. "N/A").
  jifValue             Float?    @map("jif_value")
  jifWithoutSelfValue  Float?    @map("jif_without_self_value")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  journal         Journal                 @relation(fields: [journalId], references: [id], onDelete: Cascade)
  syncTask        SyncTask?               @relation(fields: [syncTaskId], references: [id], onDelete: SetNull)
  categoryMetrics JournalCategoryMetric[]

  @@unique([journalId, jcrYear, revision])
  @@index([journalId, jcrYear, retrievedAt])
  @@index([syncTaskId])
  @@map("journal_metric_snapshots")
}

// ─── 14. JournalCategoryMetric (Phase 15) ──────────────────────────────────

/// Per-category rank, quartile and percentile within a snapshot. `edition` is never NULL ('' when
/// the API gives none), so the unique constraint also prevents duplicates of edition-less rows.
/// Unfamiliar edition identifiers are stored as returned (no allowlist). Hand-written CHECKs:
/// quartile Q1–Q4, rank and rank_total positive.
model JournalCategoryMetric {
  id           String        @id @default(uuid()) @db.Uuid
  snapshotId   String        @map("snapshot_id") @db.Uuid
  metric       JcrRankMetric
  /// Trimmed, whitespace-collapsed, upper-case.
  categoryName String        @map("category_name")
  /// From the rank's `self` link, e.g. "RO_SCIE".
  categoryCode String?       @map("category_code")
  edition      String        @default("")
  rankText     String?       @map("rank_text")
  rank         Int?
  rankTotal    Int?          @map("rank_total")
  quartile     String?
  percentile   Float?

  snapshot JournalMetricSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, metric, categoryName, edition])
  @@map("journal_category_metrics")
}
