{
  "name": "cse-research-hub-backend",
  "version": "1.0.0",
  "description": "Backend service for Professor Research Publication Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "fixtures:openalex": "tsx scripts/record-openalex-fixtures.ts",
    "smoke:openalex": "tsx scripts/openalex-smoke.ts",
    "fixtures:dblp": "tsx scripts/record-dblp-fixtures.ts",
    "smoke:dblp": "tsx scripts/dblp-smoke.ts",
    "fixtures:orcid": "tsx scripts/record-orcid-fixtures.ts",
    "smoke:orcid": "tsx scripts/orcid-smoke.ts",
    "demo": "tsx scripts/demo-discovery.ts",
    "lint": "eslint",
    "admin": "tsx scripts/admin-account.ts",
    "provider-removal": "tsx scripts/provider-removal.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prisma": "^6.4.1",
    "supertest": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
